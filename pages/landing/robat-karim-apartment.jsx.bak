// pages/landing/robat-karim-apartments.jsx
import React, { useState, useEffect } from 'react';
import Image from 'next/image';
import Grid from '@mui/material/Grid';
import Box from '@mui/material/Box';
import Link from 'next/link';
import WorkerCard from '../../components/cards/WorkerCard';
import Head from 'next/head';

export default function RabatKarimApartmentsPage() {
  const [apartments, setApartments] = useState([]);
  const [loading, setLoading] = useState(true);

  useEffect(() => {
    fetchApartments();
  }, []);

  const fetchApartments = async () => {
    try {
      const res = await fetch('https://api.boomlex.ir/api/robat-karim-apartments');
      const data = await res.json();
      
      let apts = [];
      if (Array.isArray(data)) {
        apts = data.slice(0, 12);
      } else if (data.apartments && Array.isArray(data.apartments)) {
        apts = data.apartments.slice(0, 12);
      } else if (data.items && Array.isArray(data.items)) {
        apts = data.items.slice(0, 12);
      } else if (data.data && Array.isArray(data.data)) {
        apts = data.data.slice(0, 12);
      }
      
      setApartments(apts);
    } catch (error) {
      console.error('Error:', error);
      setApartments([]);
    } finally {
      setLoading(false);
    }
  };

  const availableCount = apartments.length;

  return (
    <>
      <Head>
        <title>آپارتمان‌های رباط کریم | مجموعه‌ای منتخب از بهترین واحدها</title>
        <meta name="description" content={`${availableCount} آپارتمان منتخب در رباط کریم. قیمت‌های به‌روز، مشخصات کامل و امکان رزرو آنلاین.`} />
        <meta charSet="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
        <meta name="robots" content="index, follow" />
        <link rel="icon" href="/favicon.ico" />
        <style>{`
          @import url('https://fonts.googleapis.com/css2?family=Vazirmatn:wght@400;500;700&display=swap');
          body {
            font-family: 'Vazirmatn', 'iransans', system-ui, sans-serif;
            margin: 0;
            padding: 0;
            background: white;
            direction: rtl;
          }
          * {
            box-sizing: border-box;
          }
          .cta-button {
            transition: all 0.3s ease;
          }
          .cta-button:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(0,0,0,0.15);
          }
          .apartment-card-hover:hover {
            transform: translateY(-4px);
            box-shadow: 0 10px 25px rgba(0,0,0,0.1);
          }
          @keyframes spin {
            to { transform: rotate(360deg); }
          }
        `}</style>
      </Head>

      {/* Hero Section */}
      <Box sx={{ 
        background: 'linear-gradient(135deg, #1e40af 0%, #1e3a8a 100%)',
        color: 'white',
        py: { xs: 6, md: 8 },
        px: 2,
        textAlign: 'center',
        width: '100%'
      }}>
        <h1 style={{ 
          fontSize: 'clamp(1.8rem, 4vw, 2.5rem)',
          margin: '0 0 1rem 0',
          fontWeight: 'bold',
          lineHeight: 1.3
        }}>
          {availableCount} آپارتمان به قیمت و کارشناسی شده در رباط کریم
        </h1>
        <p style={{ 
          fontSize: 'clamp(1rem, 2vw, 1.2rem)',
          opacity: 0.9,
          margin: '0 auto 2rem',
          maxWidth: '600px',
          lineHeight: 1.6
        }}>
          دسترسی مستقیم به بهترین واحدهای کارشناسی شده بوملکس در رباط کریم
        </p>
        <button 
          onClick={() => window.location.href = 'tel:+989382740488'}
          style={{
            background: '#f59e0b',
            color: 'white',
            border: 'none',
            padding: '14px 36px',
            fontSize: '1.1rem',
            borderRadius: '8px',
            fontWeight: 'bold',
            cursor: 'pointer',
            boxShadow: '0 4px 14px rgba(245, 158, 11, 0.4)'
          }}
          className="cta-button"
        >
           تماس فوری: 09382740488 
        </button>
      </Box>

      {/* Loading State */}
      {loading ? (
        <Box sx={{ 
          display: 'flex', 
          justifyContent: 'center', 
          alignItems: 'center',
          minHeight: '400px',
          textAlign: 'center'
        }}>
          <div>
            <div style={{ 
              width: '50px', 
              height: '50px', 
              border: '4px solid #e2e8f0',
              borderTopColor: '#1e40af',
              borderRadius: '50%',
              animation: 'spin 1s linear infinite',
              margin: '0 auto 1rem'
            }}></div>
            <p style={{ color: '#64748b' }}>در حال بارگذاری آپارتمان‌ها...</p>
          </div>
        </Box>
      ) : (
        <>
          {/* Stats */}
          {availableCount > 0 && (
            <Box sx={{ 
              bgcolor: '#f8fafc',
              py: 3,
              borderBottom: '1px solid #e2e8f0'
            }}>
              <Grid container sx={{ maxWidth: '1200px', margin: '0 auto', px: 2 }}>
                {[
                  { value: availableCount, label: 'واحد کارشناسی شده' },
                  { value: '۶۰-۲۰۰', label: 'متراژ متنوع' },
                  { value: '۲۴h', label: 'پاسخگویی' },
                  { value: '۱۰۰٪', label: 'تضمین قیمت' }
                ].map((stat, index) => (
                  <Grid item xs={3} key={index} sx={{ textAlign: 'center' }}>
                    <div style={{ 
                      fontSize: '1.5rem', 
                      fontWeight: 'bold', 
                      color: '#1e40af',
                      marginBottom: '0.25rem'
                    }}>
                      {stat.value}
                    </div>
                    <div style={{ 
                      fontSize: '0.85rem', 
                      color: '#64748b',
                      fontWeight: '500'
                    }}>
                      {stat.label}
                    </div>
                  </Grid>
                ))}
              </Grid>
            </Box>
          )}

          {/* Apartments Grid */}
          <Box sx={{ 
            py: 6,
            maxWidth: '1200px',
            margin: '0 auto',
            px: { xs: 2, md: 3 },
            minHeight: '500px'
          }}>
            {availableCount > 0 ? (
              <>
                <div style={{
                  display: 'flex',
                  justifyContent: 'space-between',
                  alignItems: 'center',
                  marginBottom: '2rem',
                  flexWrap: 'wrap',
                  gap: '1rem'
                }}>
                  <h2 style={{
                    color: '#1e293b',
                    fontSize: '1.5rem',
                    fontWeight: 'bold',
                    margin: 0
                  }}>
                    آپارتمان‌های رباط کریم ({availableCount} واحد)
                  </h2>
                  <button 
                    onClick={() => {
                      document.getElementById('contact-form')?.scrollIntoView({ behavior: 'smooth' });
                    }}
                    style={{
                      background: 'transparent',
                      color: '#1e40af',
                      border: '2px solid #1e40af',
                      padding: '8px 20px',
                      borderRadius: '6px',
                      fontWeight: 'bold',
                      cursor: 'pointer',
                      fontSize: '0.9rem'
                    }}
                  >
                    درخواست مشاوره رایگان
                  </button>
                </div>
                
                <Grid container spacing={3}>
                  {apartments.map((apartment) => (
                    <Grid item xs={12} sm={6} md={4} lg={3} key={apartment.id}>
                      <div className="apartment-card-hover" style={{ transition: 'all 0.3s ease' }}>
                        <Link 
                          href={`/worker/${apartment.id}?slug=${apartment.slug || ''}`}
                          style={{ textDecoration: 'none', display: 'block' }}
                        >
                          <WorkerCard worker={apartment} />
                        </Link>
                      </div>
                    </Grid>
                  ))}
                </Grid>

                {/* Quick Action Bar */}
                <Box sx={{
                  mt: 6,
                  p: 3,
                  bgcolor: '#f0f9ff',
                  borderRadius: '12px',
                  border: '1px solid #bae6fd',
                  textAlign: 'center'
                }}>
                  <p style={{ 
                    margin: '0 0 1rem 0',
                    color: '#0369a1',
                    fontSize: '1.1rem',
                    fontWeight: '500'
                  }}>
                    برای بازدید حضوری وقت رزرو کنید
                  </p>
                  <div style={{ display: 'flex', gap: '1rem', justifyContent: 'center', flexWrap: 'wrap' }}>
                    <button 
                      onClick={() => window.location.href = 'tel:+989382740488'}
                      style={{
                        background: '#10b981',
                        color: 'white',
                        border: 'none',
                        padding: '12px 24px',
                        borderRadius: '8px',
                        fontWeight: 'bold',
                        cursor: 'pointer',
                        display: 'flex',
                        alignItems: 'center',
                        gap: '0.5rem'
                      }}
                    >
                      📞 رزرو تلفنی
                    </button>
                    <button 
                      onClick={() => window.open('https://wa.me/989382740488', '_blank')}
                      style={{
                        background: '#25D366',
                        color: 'white',
                        border: 'none',
                        padding: '12px 24px',
                        borderRadius: '8px',
                        fontWeight: 'bold',
                        cursor: 'pointer',
                        display: 'flex',
                        alignItems: 'center',
                        gap: '0.5rem'
                      }}
                    >
                      💬 رزرو در واتساپ
                    </button>
                  </div>
                </Box>
              </>
            ) : (
              <Box sx={{ 
                display: 'flex', 
                flexDirection: 'column',
                alignItems: 'center',
                justifyContent: 'center',
                minHeight: '400px',
                textAlign: 'center'
              }}>
                <Image
                  src="/logo/half-heart.png"
                  alt="ajur half heart"
                  width={100}
                  height={99}
                  style={{ opacity: 0.6 }}
                />
                <h3 style={{ marginTop: '1.5rem', color: '#475569', fontSize: '1.25rem' }}>
                  آپارتمانی برای نمایش وجود ندارد
                </h3>
                <p style={{ 
                  color: '#64748b', 
                  maxWidth: '500px', 
                  marginTop: '0.75rem',
                  lineHeight: 1.6
                }}>
                  با کارشناسان ما تماس بگیرید تا بهترین گزینه‌ها را به شما معرفی کنند.
                </p>
              </Box>
            )}
          </Box>

          {/* Contact Form */}
          <Box 
            id="contact-form"
            sx={{
              py: 8,
              px: { xs: 2, md: 3 },
              bgcolor: '#f8fafc',
              borderTop: '1px solid #e2e8f0'
            }}
          >
            <div style={{ maxWidth: '800px', margin: '0 auto' }}>
              <h2 style={{
                textAlign: 'center',
                color: '#1e293b',
                fontSize: '1.8rem',
                fontWeight: 'bold',
                marginBottom: '0.5rem'
              }}>
                فرم درخواست مشاوره
              </h2>
              <p style={{
                textAlign: 'center',
                color: '#64748b',
                marginBottom: '3rem'
              }}>
                اطلاعات خود را وارد کنید تا کارشناسان بوملکس با شما تماس بگیرند
              </p>

              <Grid container spacing={3}>
                <Grid item xs={12} md={6}>
                  <input 
                    type="text"
                    placeholder="نام و نام خانوادگی"
                    style={{
                      width: '100%',
                      padding: '14px',
                      border: '1px solid #cbd5e1',
                      borderRadius: '8px',
                      fontSize: '1rem',
                      outline: 'none',
                      transition: 'all 0.3s'
                    }}
                  />
                </Grid>
                <Grid item xs={12} md={6}>
                  <input 
                    type="tel"
                    placeholder="شماره تماس"
                    style={{
                      width: '100%',
                      padding: '14px',
                      border: '1px solid #cbd5e1',
                      borderRadius: '8px',
                      fontSize: '1rem',
                      outline: 'none',
                      transition: 'all 0.3s'
                    }}
                  />
                </Grid>
                <Grid item xs={12}>
                  <textarea
                    placeholder="توضیحات یا سوالات شما"
                    rows={4}
                    style={{
                      width: '100%',
                      padding: '14px',
                      border: '1px solid #cbd5e1',
                      borderRadius: '8px',
                      fontSize: '1rem',
                      outline: 'none',
                      resize: 'vertical',
                      minHeight: '120px',
                      transition: 'all 0.3s'
                    }}
                  />
                </Grid>
                <Grid item xs={12}>
                  <button 
                    onClick={() => alert('درخواست شما ثبت شد. به زودی با شما تماس می‌گیریم.')}
                    style={{
                      width: '100%',
                      background: 'linear-gradient(135deg, #1e40af 0%, #1e3a8a 100%)',
                      color: 'white',
                      border: 'none',
                      padding: '16px',
                      borderRadius: '8px',
                      fontSize: '1.1rem',
                      fontWeight: 'bold',
                      cursor: 'pointer',
                      transition: 'all 0.3s'
                    }}
                    className="cta-button"
                  >
                    ارسال درخواست مشاوره رایگان
                  </button>
                </Grid>
              </Grid>
            </div>
          </Box>

          {/* Footer */}
          <Box sx={{
            py: 4,
            px: 3,
            bgcolor: '#1e293b',
            color: 'white',
            textAlign: 'center'
          }}>
            <div style={{ maxWidth: '1200px', margin: '0 auto' }}>
              <p style={{ margin: 0, fontSize: '0.9rem', opacity: 0.8 }}>
                © {new Date().getFullYear()} بوملکس - مشاور املاک هوشمند. تمامی حقوق محفوظ است.
              </p>
              <div style={{ 
                display: 'flex', 
                justifyContent: 'center', 
                gap: '2rem',
                marginTop: '1rem',
                flexWrap: 'wrap'
              }}>
                <a href="https://boomlex.ir" style={{ color: '#60a5fa', textDecoration: 'none' }}>
                  صفحه اصلی بوملکس
                </a>
                <a href="tel:+989382740488" style={{ color: '#60a5fa', textDecoration: 'none' }}>
                  ۰۲۱-۰۰۰۰۰۰۰۰
                </a>
                <a href="mailto:contact@boomlex.ir" style={{ color: '#60a5fa', textDecoration: 'none' }}>
                  contact@boomlex.ir
                </a>
              </div>
            </div>
          </Box>
        </>
      )}
    </>
  );
}


