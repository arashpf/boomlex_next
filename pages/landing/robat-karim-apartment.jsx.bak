// pages/landing/robat-karim-apartments.jsx
import React, { useState, useEffect } from 'react';
import Image from 'next/image';
import Grid from '@mui/material/Grid';
import Box from '@mui/material/Box';
import Link from 'next/link';
import WorkerCard from '../../components/cards/WorkerCard';
import Head from 'next/head';

export default function RabatKarimApartmentsPage() {
  const [apartments, setApartments] = useState([]);
  const [loading, setLoading] = useState(true);

  useEffect(() => {
    fetchApartments();
  }, []);

  const fetchApartments = async () => {
    try {
      const res = await fetch('https://api.boomlex.ir/api/robat-karim-apartments');
      const data = await res.json();
      
      let apts = [];
      if (Array.isArray(data)) {
        apts = data.slice(0, 12);
      } else if (data.apartments && Array.isArray(data.apartments)) {
        apts = data.apartments.slice(0, 12);
      } else if (data.items && Array.isArray(data.items)) {
        apts = data.items.slice(0, 12);
      } else if (data.data && Array.isArray(data.data)) {
        apts = data.data.slice(0, 12);
      }
      
      setApartments(apts);
    } catch (error) {
      console.error('Error:', error);
      setApartments([]);
    } finally {
      setLoading(false);
    }
  };

  const availableCount = apartments.length;

  return (
    <>
      <Head>
        <title>آپارتمان‌های رباط کریم | مجموعه‌ای منتخب از بهترین واحدها</title>
        <meta name="description" content={`${availableCount} آپارتمان منتخب در رباط کریم. قیمت‌های به‌روز، مشخصات کامل و امکان رزرو آنلاین.`} />
        <meta charSet="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
        <meta name="robots" content="index, follow" />
        <link rel="icon" href="/favicon.ico" />
        <style>{`
          @import url('https://fonts.googleapis.com/css2?family=Vazirmatn:wght@400;500;700&display=swap');
          body {
            font-family: 'Vazirmatn', 'iransans', system-ui, sans-serif;
            margin: 0;
            padding: 0;
            background: white;
          }
          * {
            box-sizing: border-box;
          }
          .cta-button {
            transition: all 0.3s ease;
          }
          .cta-button:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(0,0,0,0.15);
          }
          .apartment-card-hover:hover {
            transform: translateY(-4px);
            box-shadow: 0 10px 25px rgba(0,0,0,0.1);
          }
          @keyframes spin {
            to { transform: rotate(360deg); }
          }
          .persian-text {
            text-align: right;
            direction: rtl;
          }
        `}</style>
      </Head>

      {/* Hero Section */}
      <Box sx={{ 
        background: 'linear-gradient(135deg, #1e40af 0%, #1e3a8a 100%)',
        color: 'white',
        py: { xs: 6, md: 8 },
        px: 2,
        textAlign: 'center',
        width: '100%',
      }}>
        <h1 className="persian-text" style={{ 
          fontSize: 'clamp(1.8rem, 4vw, 2.5rem)',
          margin: '0 0 1rem 0',
          fontWeight: 'bold',
          lineHeight: 1.3
        }}>
          {availableCount} آپارتمان به قیمت  در رباط کریم
        </h1>
        <p className="persian-text" style={{ 
          fontSize: 'clamp(1rem, 2vw, 1.2rem)',
          opacity: 0.9,
          margin: '0 auto 2rem',
          maxWidth: '600px',
          lineHeight: 1.6
        }}>
          دسترسی مستقیم به بهترین آپارتمان های کارشناسی شده بوملکس در رباط کریم
        </p>
        <div style={{ display: 'flex', gap: '1rem', justifyContent: 'center', flexWrap: 'wrap' }}>
          <button 
            onClick={() => window.location.href = 'tel:+989382740488'}
            style={{
              background: '#f59e0b',
              color: 'white',
              border: 'none',
              padding: '14px 24px',
              fontSize: '1rem',
              borderRadius: '8px',
              fontWeight: 'bold',
              cursor: 'pointer',
              boxShadow: '0 4px 14px rgba(245, 158, 11, 0.4)',
              display: 'flex',
              alignItems: 'center',
              gap: '0.5rem'
            }}
            className="cta-button"
          >
            📞 تماس: ۰۹۳۸۲۷۴۰۴۸۸
          </button>
          <button 
            onClick={() => window.open('https://wa.me/989382740488', '_blank')}
            style={{
              background: '#25D366',
              color: 'white',
              border: 'none',
              padding: '14px 24px',
              fontSize: '1rem',
              borderRadius: '8px',
              fontWeight: 'bold',
              cursor: 'pointer',
              boxShadow: '0 4px 14px rgba(37, 211, 102, 0.4)',
              display: 'flex',
              alignItems: 'center',
              gap: '0.5rem'
            }}
            className="cta-button"
          >
            💬 واتساپ
          </button>
        </div>
      </Box>

      {/* Loading State */}
      {loading ? (
        <Box sx={{ 
          display: 'flex', 
          justifyContent: 'center', 
          alignItems: 'center',
          minHeight: '400px',
          textAlign: 'center'
        }}>
          <div className="persian-text">
            <div style={{ 
              width: '50px', 
              height: '50px', 
              border: '4px solid #e2e8f0',
              borderTopColor: '#1e40af',
              borderRadius: '50%',
              animation: 'spin 1s linear infinite',
              margin: '0 auto 1rem'
            }}></div>
            <p style={{ color: '#64748b' }}>در حال بارگذاری آپارتمان‌ها...</p>
          </div>
        </Box>
      ) : (
        <>
          

          {/* Apartments Grid - 1 on mobile, 3 on desktop */}
          <Box sx={{ 
            py: 6,
            maxWidth: '1200px',
            margin: '0 auto',
            px: { xs: 2, md: 3 },
            minHeight: '500px'
          }}>
            {availableCount > 0 ? (
              <>
                {/* <div className="persian-text" style={{
                  display: 'flex',
                  justifyContent: 'space-between',
                  alignItems: 'center',
                  marginBottom: '2rem',
                  flexWrap: 'wrap',
                  gap: '1rem',
                }}>
                  <h2 style={{
                    color: '#1e293b',
                    fontSize: '1.5rem',
                    fontWeight: 'bold',
                    margin: 0,
                    textAlign: 'right'
                  }}>
                    آپارتمان‌های رباط کریم ({availableCount} واحد)
                  </h2>
                  <div style={{ display: 'flex', gap: '0.5rem' }}>
                    <button 
                      onClick={() => window.location.href = 'tel:+989382740488'}
                      style={{
                        background: '#10b981',
                        color: 'white',
                        border: 'none',
                        padding: '8px 16px',
