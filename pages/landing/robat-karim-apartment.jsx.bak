                        border: 'none',
                        padding: '8px 16px',
                        borderRadius: '6px',
                        fontWeight: 'bold',
                        cursor: 'pointer',
                        fontSize: '0.9rem',
                        display: 'flex',
                        alignItems: 'center',
                        gap: '0.25rem'
                      }}
                    >
                      💬 واتساپ
                    </button>
                  </div>
                </div> */}

                
                
                {/* Grid: 1 column on mobile, 3 columns on desktop */}
                <Grid container spacing={3}>
                  {apartments.map((apartment) => (
                    <Grid item xs={12} sm={6} md={4} key={apartment.id}>
                      <div className="apartment-card-hover" style={{ transition: 'all 0.3s ease' }}>
                        <Link 
                          href={`/worker/${apartment.id}?slug=${apartment.slug || ''}`}
                          style={{ textDecoration: 'none', display: 'block' }}
                        >
                          <WorkerCard worker={apartment} />
                        </Link>
                      </div>
                    </Grid>
                  ))}
                </Grid>

                {/* Stats */}
          {availableCount > 0 && (
            <Box sx={{ 
              bgcolor: '#f8fafc',
              py: 3,
              borderBottom: '1px solid #e2e8f0'
            }}>
              <Grid container sx={{ maxWidth: '1200px', margin: '0 auto', px: 2 }}>
                {[
                  { value: availableCount, label: 'واحد کارشناسی شده جدید' },
                  { value: '۶۰-۲۰۰', label: 'متراژ متنوع' },
